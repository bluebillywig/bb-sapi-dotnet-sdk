<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlueBillywig.Sapi</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>true</IsPackable>

    <PackageId>BlueBillywig.Sapi</PackageId>
    <Version>1.0.0</Version>
    <Authors>Blue Billywig</Authors>
    <Company>Blue Billywig</Company>
    <Description>Blue Billywig Server API (SAPI) SDK for .NET</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/bluebillywig/bb-sapi-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bluebillywig/bb-sapi-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bluebillywig;sapi;video;ovp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
